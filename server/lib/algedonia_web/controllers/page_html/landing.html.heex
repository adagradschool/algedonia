<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Algedonia</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="bg-surface text-fg min-h-screen">
    <div class="min-h-screen flex flex-col items-center justify-center px-4">
      <div class="max-w-md w-full text-center space-y-8">
        <div class="flex items-center justify-center gap-3">
          <div class="w-10 h-10 bg-accent-indigo rounded-xl flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-6 text-white"
            >
              <path d="M11.644 1.59a.75.75 0 0 1 .712 0l9.75 5.25a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.712 0l-9.75-5.25a.75.75 0 0 1 0-1.32l9.75-5.25Z" />
              <path d="m3.265 10.602 7.668 4.129a2.25 2.25 0 0 0 2.134 0l7.668-4.13 1.37.739a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.71 0l-9.75-5.25a.75.75 0 0 1 0-1.32l1.37-.738Z" />
              <path d="m3.265 15.602 7.668 4.129a2.25 2.25 0 0 0 2.134 0l7.668-4.13 1.37.739a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.71 0l-9.75-5.25a.75.75 0 0 1 0-1.32l1.37-.738Z" />
            </svg>
          </div>
          <h1 class="text-3xl font-bold text-fg">Algedonia</h1>
        </div>

        <p class="text-fg-secondary text-lg">Feel the AGI</p>

        <a
          href={~p"/auth/github"}
          class="inline-flex items-center gap-3 px-6 py-3 bg-[#24292f] hover:bg-[#32383f] text-white font-medium rounded-lg transition-colors"
        >
          <svg class="size-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
          Sign in with GitHub
        </a>
      </div>

      <div class="max-w-2xl w-full mt-16 space-y-12">
        <div>
          <h2 class="text-lg font-semibold text-fg text-center mb-6">How it works</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-surface-panel border border-border rounded-xl p-5 text-center space-y-2">
              <div class="w-9 h-9 bg-accent-indigo/20 rounded-lg flex items-center justify-center mx-auto">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-5 text-accent-indigo"
                >
                  <path d="M5.433 13.917l1.262-3.155A4 4 0 017.58 9.42l6.92-6.918a2.121 2.121 0 013 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 01-.65-.65z" />
                  <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0010 3H4.75A2.75 2.75 0 002 5.75v9.5A2.75 2.75 0 004.75 18h9.5A2.75 2.75 0 0017 15.25V10a.75.75 0 00-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5z" />
                </svg>
              </div>
              <h3 class="text-sm font-semibold text-fg">Describe</h3>
              <p class="text-xs text-fg-muted">Write a ticket describing what you want built.</p>
            </div>
            <div class="bg-surface-panel border border-border rounded-xl p-5 text-center space-y-2">
              <div class="w-9 h-9 bg-accent-indigo/20 rounded-lg flex items-center justify-center mx-auto">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-5 text-accent-indigo"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.403 12.652a3 3 0 000-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
              <h3 class="text-sm font-semibold text-fg">Verify</h3>
              <p class="text-xs text-fg-muted">
                AI builds it, then a second AI verifies against your rubric.
              </p>
            </div>
            <div class="bg-surface-panel border border-border rounded-xl p-5 text-center space-y-2">
              <div class="w-9 h-9 bg-accent-indigo/20 rounded-lg flex items-center justify-center mx-auto">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-5 text-accent-indigo"
                >
                  <path d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z" />
                  <path d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z" />
                </svg>
              </div>
              <h3 class="text-sm font-semibold text-fg">Ship</h3>
              <p class="text-xs text-fg-muted">
                Review the verified diff and merge with confidence.
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-surface-panel border border-border rounded-xl p-5 space-y-1">
            <h3 class="text-sm font-semibold text-fg">Verification First</h3>
            <p class="text-xs text-fg-muted">
              One agent builds, another verifies. Every change is checked before you see it.
            </p>
          </div>
          <div class="bg-surface-panel border border-border rounded-xl p-5 space-y-1">
            <h3 class="text-sm font-semibold text-fg">Integrated Issue Tracker</h3>
            <p class="text-xs text-fg-muted">
              Tickets, agents, and diffs in one place. No context switching.
            </p>
          </div>
          <div class="bg-surface-panel border border-border rounded-xl p-5 space-y-1">
            <h3 class="text-sm font-semibold text-fg">Polyagentic</h3>
            <p class="text-xs text-fg-muted">
              Use Claude Code, Codex, Aider, or all three at once.
            </p>
          </div>
          <div class="bg-surface-panel border border-border rounded-xl p-5 space-y-1">
            <h3 class="text-sm font-semibold text-fg">Multiplayer</h3>
            <p class="text-xs text-fg-muted">Collaborate in real-time with your team.</p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
