<div class="flex items-center justify-center min-h-screen">
  <div class="text-center space-y-4">
    <h1 class="text-2xl font-bold text-fg">Authentication Failed</h1>
    <p class="text-fg-secondary">{@message}</p>
    <p class="text-sm text-fg-muted">
      Run
      <code class="bg-surface-raised px-1.5 py-0.5 rounded font-mono text-xs">ag connect</code>
      to authenticate.
    </p>
  </div>
</div>
