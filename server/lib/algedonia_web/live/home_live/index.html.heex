<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_workspace={@current_workspace}
  current_user={@current_user}
  user_workspaces={@user_workspaces}
  workspace_daemon_status={@workspace_daemon_status}
  nav_section={@nav_section}
  current_path={@current_path}
>
  <div class="flex flex-col h-full">
    <header class="h-12 border-b border-border flex items-center justify-between px-6 bg-surface flex-shrink-0">
      <div class="flex items-center gap-2">
        <h1 class="text-sm font-semibold text-fg">Home</h1>
      </div>
    </header>

    <div class="p-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-surface-panel border border-border rounded-xl p-5">
          <h2 class="text-sm font-semibold text-fg">Welcome back</h2>
          <p class="text-sm text-fg-secondary mt-2">
            Your work hub for tickets, monitors, and loops. Everything is fast, searchable, and organized.
          </p>
          <div class="mt-4 flex items-center gap-2">
            <.link
              navigate={~p"/w/#{@workspace_slug}/tickets"}
              class="px-3 py-1.5 bg-accent-indigo hover:bg-accent-indigo-hover text-white text-xs font-medium rounded-md transition-colors"
            >
              Go to issues
            </.link>
            <.link
              navigate={~p"/w/#{@workspace_slug}/monitor"}
              class="px-3 py-1.5 bg-surface-raised hover:bg-surface-panel text-fg text-xs font-medium rounded-md transition-colors"
            >
              Open monitor
            </.link>
          </div>
        </div>

        <div class="bg-surface-panel border border-border rounded-xl p-5">
          <h2 class="text-sm font-semibold text-fg">Quick actions</h2>
          <div class="mt-3 space-y-2">
            <.link
              patch={~p"/w/#{@workspace_slug}/tickets/new"}
              class="flex items-center justify-between px-3 py-2 rounded-md border border-border text-xs text-fg hover:bg-surface-raised transition-colors"
            >
              Create a new issue <.icon name="hero-plus-mini" class="size-4 text-fg-muted" />
            </.link>
            <.link
              navigate={~p"/w/#{@workspace_slug}/monitor"}
              class="flex items-center justify-between px-3 py-2 rounded-md border border-border text-xs text-fg hover:bg-surface-raised transition-colors"
            >
              View daemon status <.icon name="hero-signal" class="size-4 text-fg-muted" />
            </.link>
            <.link
              navigate={~p"/w/#{@workspace_slug}/tickets"}
              class="flex items-center justify-between px-3 py-2 rounded-md border border-border text-xs text-fg hover:bg-surface-raised transition-colors"
            >
              View halted tickets <.icon name="hero-pause-circle" class="size-4 text-fg-muted" />
            </.link>
          </div>
        </div>
      </div>

      <div
        :if={@current_workspace}
        class="mt-6 bg-surface-panel border border-border rounded-xl p-5"
      >
        <h2 class="text-sm font-semibold text-fg">Connect a daemon</h2>
        <p class="text-sm text-fg-secondary mt-2">
          Use the GitHub device flow to connect the daemon to this workspace.
        </p>
        <pre class="mt-3 text-xs text-fg bg-surface-sunken border border-border rounded-lg p-3 overflow-auto">ag login</pre>
      </div>
    </div>
  </div>
</Layouts.app>
