<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_workspace={@current_workspace}
  current_user={@current_user}
  user_workspaces={@user_workspaces}
  nav_section={@nav_section}
  current_path={@current_path}
>
  <div class="flex flex-col h-full">
    <header class="h-12 border-b border-border flex items-center justify-between px-6 bg-surface flex-shrink-0">
      <div class="flex items-center gap-2">
        <h1 class="text-sm font-semibold text-fg">Daemon Monitor</h1>
        <span class="text-[11px] text-fg-muted">{@daemon_count}</span>
      </div>
      <.presence_indicator presences={@presences} current_user={@display_name} />
    </header>

    <div class="p-6">
      <div
        :if={@daemon_count == 0}
        class="flex flex-col items-center justify-center py-16 space-y-3"
      >
        <.icon name="hero-signal" class="size-10 text-fg-muted" />
        <h3 class="text-sm font-semibold text-fg">No daemons connected</h3>
        <p class="text-xs text-fg-muted">Install the daemon to start running agents.</p>
        <div class="mt-2 bg-surface-raised rounded-lg p-3">
          <code class="text-xs text-fg font-mono">
            curl -fsSL {AlgedoniaWeb.Endpoint.url()}/install.sh | sh
          </code>
        </div>
      </div>

      <div
        :if={@daemon_count > 0}
        class="bg-surface-panel border border-border rounded-xl overflow-hidden"
      >
        <table class="min-w-full">
          <thead class="bg-surface-raised border-b border-border">
            <tr>
              <th class="px-6 py-3 text-left text-[11px] font-medium text-fg-muted uppercase tracking-wider">
                Status
              </th>
              <th class="px-6 py-3 text-left text-[11px] font-medium text-fg-muted uppercase tracking-wider">
                Name
              </th>
              <th class="px-6 py-3 text-left text-[11px] font-medium text-fg-muted uppercase tracking-wider">
                Capacity
              </th>
              <th class="px-6 py-3 text-left text-[11px] font-medium text-fg-muted uppercase tracking-wider">
                Running
              </th>
              <th class="px-6 py-3 text-left text-[11px] font-medium text-fg-muted uppercase tracking-wider">
                Last Heartbeat
              </th>
            </tr>
          </thead>
          <tbody id="daemons" phx-update="stream" class="divide-y divide-border">
            <tr
              :for={{dom_id, daemon} <- @streams.daemons}
              id={dom_id}
              class="hover:bg-surface-raised/60"
            >
              <td class="px-6 py-4 whitespace-nowrap">
                <span class={"inline-block w-2.5 h-2.5 rounded-full #{status_color(daemon.status)}"}>
                </span>
                <span class="ml-2 text-sm text-fg-secondary">{daemon.status}</span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-fg">
                {daemon.display_name || daemon.name}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-fg-secondary">
                {daemon.capacity}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-fg-secondary">
                {daemon.running_loops}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-fg-secondary">
                {relative_time(daemon.last_heartbeat_at)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <.modal
    :if={@show_new_workspace_modal}
    id="new-workspace-modal"
    show
    on_cancel={JS.push("close_new_workspace_modal")}
  >
    <h2 class="text-lg font-semibold text-fg mb-4">New workspace</h2>
    <.live_component
      module={AlgedoniaWeb.WorkspaceLive.NewWorkspaceFormComponent}
      id="new-workspace-form"
      form={@new_workspace_form}
    />
  </.modal>
</Layouts.app>
