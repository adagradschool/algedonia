<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Daemon Monitor</h1>
    <.presence_indicator presences={@presences} current_user={@display_name} />
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Status
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Name
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Capacity
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Running
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Last Heartbeat
          </th>
        </tr>
      </thead>
      <tbody id="daemons" phx-update="stream" class="bg-white divide-y divide-gray-200">
        <tr :for={{dom_id, daemon} <- @streams.daemons} id={dom_id} class="hover:bg-gray-50">
          <td class="px-6 py-4 whitespace-nowrap">
            <span class={"inline-block w-3 h-3 rounded-full #{status_color(daemon.status)}"}>
            </span>
            <span class="ml-2 text-sm text-gray-600">{daemon.status}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
            {daemon.display_name || daemon.name}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
            {daemon.capacity}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
            {daemon.running_loops}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
            {relative_time(daemon.last_heartbeat_at)}
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
