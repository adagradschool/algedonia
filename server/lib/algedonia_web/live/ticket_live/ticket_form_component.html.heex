<div class="space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-sm font-semibold text-fg">
        {if @action == :new, do: "New issue", else: "Edit issue"}
      </h2>
    </div>
  </div>
  <.form
    for={@form}
    id="ticket-form"
    phx-target={@myself}
    phx-change="validate"
    phx-submit="save"
    class="space-y-4"
  >
    <.input
      field={@form[:title]}
      type="text"
      label="Title"
      placeholder="Issue title"
      class="w-full rounded-md bg-surface-panel border border-border text-sm font-medium text-fg placeholder-fg-muted px-3 py-2 focus:outline-none focus:border-accent-indigo"
      required
    />
    <.input
      field={@form[:description]}
      type="textarea"
      label="Description"
      placeholder="Add description"
      rows="4"
      class="w-full rounded-md bg-surface-panel border border-border text-sm text-fg placeholder-fg-muted px-3 py-2 focus:outline-none focus:border-accent-indigo min-h-24"
    />
    <.input
      field={@form[:acceptance_criteria]}
      type="textarea"
      label="Acceptance Criteria"
      placeholder="Add acceptance criteria"
      rows="3"
      class="w-full rounded-md bg-surface-panel border border-border text-sm text-fg placeholder-fg-muted px-3 py-2 focus:outline-none focus:border-accent-indigo"
    />
    <.input
      field={@form[:rubric]}
      type="textarea"
      label="Rubric"
      placeholder="Add rubric"
      rows="3"
      class="w-full rounded-md bg-surface-panel border border-border text-sm text-fg placeholder-fg-muted px-3 py-2 focus:outline-none focus:border-accent-indigo"
    />

    <div class="grid grid-cols-2 gap-3 pt-2">
      <.input
        field={@form[:status]}
        type="select"
        label="Status"
        options={status_options()}
        class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg px-2.5 py-2 focus:outline-none focus:border-accent-indigo"
      />
      <.input
        field={@form[:priority]}
        type="select"
        label="Priority"
        options={priority_options()}
        class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg px-2.5 py-2 focus:outline-none focus:border-accent-indigo"
      />
      <.input
        field={@form[:type]}
        type="select"
        label="Type"
        options={type_options()}
        class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg px-2.5 py-2 focus:outline-none focus:border-accent-indigo"
      />
      <.input
        field={@form[:coding_agent]}
        type="select"
        label="Coding Agent"
        options={coding_agent_options()}
        class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg px-2.5 py-2 focus:outline-none focus:border-accent-indigo"
      />
      <.input
        field={@form[:assignee]}
        type="text"
        label="Assignee"
        placeholder="Assignee"
        class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg placeholder-fg-muted px-3 py-2 focus:outline-none focus:border-accent-indigo"
      />
    </div>

    <div :if={@blocked_by_options != []} class="pt-2">
      <div class="fieldset mb-2">
        <span class="label mb-1">Depends On</span>
        <button
          :if={!@depends_on_expanded}
          id="ticket-form-expand-depends-on"
          type="button"
          phx-click="expand_depends_on"
          phx-target={@myself}
          class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg px-3 py-2 text-left hover:border-accent-indigo focus:outline-none focus:border-accent-indigo"
        >
          Add blockers
        </button>
        <label :if={@depends_on_expanded}>
          <input
            type="text"
            placeholder="Search tickets..."
            value={@blocked_by_search}
            phx-keyup="filter_blocked_by"
            phx-target={@myself}
            class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg placeholder-fg-muted px-3 py-2 focus:outline-none focus:border-accent-indigo mb-1"
          />
          <select
            id="ticket-form-blocked-by"
            name="ticket[blocked_by][]"
            multiple
            size={
              min(length(filtered_blocked_by_options(@blocked_by_options, @blocked_by_search)), 6)
            }
            class="w-full rounded-md bg-surface-panel border border-border text-xs text-fg px-2.5 py-2 focus:outline-none focus:border-accent-indigo"
          >
            {Phoenix.HTML.Form.options_for_select(
              filtered_blocked_by_options(@blocked_by_options, @blocked_by_search),
              @form[:blocked_by].value || []
            )}
          </select>
        </label>
        <p
          :for={msg <- Enum.map(@form[:blocked_by].errors || [], &translate_error(&1))}
          class="mt-1.5 flex gap-2 items-center text-sm text-error"
        >
          {msg}
        </p>
      </div>
    </div>

    <div class="flex justify-end pt-2">
      <button
        type="submit"
        phx-disable-with="Saving..."
        class="px-4 py-1.5 bg-accent-indigo hover:bg-accent-indigo-hover text-white text-xs font-medium rounded-md transition-colors"
      >
        {@action_label}
      </button>
    </div>
  </.form>
</div>
