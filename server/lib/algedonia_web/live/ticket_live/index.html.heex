<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_workspace={@current_workspace}
  current_user={@current_user}
  user_workspaces={@user_workspaces}
  nav_section={@nav_section}
  current_path={@current_path}
>
  <div
    id="ticket-shell"
    class="flex flex-col h-full"
    phx-hook="KeyboardShortcuts"
    data-page="tickets"
  >
    <div id="ticket-list-prefs" phx-hook="TicketListPrefs" data-workspace-slug={@workspace_slug} />
    <%!-- Header bar --%>
    <header class="h-12 border-b border-border flex items-center justify-between px-6 bg-surface flex-shrink-0">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <h1 class="text-sm font-semibold text-fg">Active issues</h1>
          <span class="text-[11px] text-fg-muted">{@ticket_count}</span>
        </div>

        <form
          :if={@live_action != :show}
          phx-change="search"
          class="relative"
        >
          <.icon
            name="hero-magnifying-glass-mini"
            class="size-3.5 text-fg-muted absolute left-2 top-1/2 -translate-y-1/2 pointer-events-none"
          />
          <input
            type="text"
            name="q"
            value={@filter_query || ""}
            placeholder="Search issues"
            phx-debounce="200"
            class="w-56 pl-7 pr-2 py-1 bg-surface-raised border border-border rounded-md text-xs text-fg placeholder-fg-muted focus:outline-none focus:border-accent-indigo"
          />
        </form>

        <%!-- Filter dropdown --%>
        <div class="dropdown dropdown-end">
          <label
            tabindex="0"
            class="flex items-center gap-1.5 px-2 py-1 bg-surface-raised border border-border rounded-md text-xs text-fg-secondary hover:text-fg transition-colors cursor-pointer"
          >
            <.icon name="hero-funnel" class="size-3" /> Filter
          </label>
          <ul
            tabindex="0"
            class="dropdown-content menu bg-surface-raised border border-border rounded-lg z-10 w-52 p-1 shadow-lg mt-1"
          >
            <li>
              <button
                phx-click="clear_filters"
                class={["text-xs rounded", !@filter_status && "text-fg bg-accent-indigo/10"]}
              >
                All statuses
              </button>
            </li>
            <li :for={status <- @statuses}>
              <button
                phx-click="filter"
                phx-value-status={status}
                class={[
                  "text-xs rounded",
                  @filter_status == status && "text-fg bg-accent-indigo/10"
                ]}
              >
                <.status_icon status={status} /> {status_label(status)}
              </button>
            </li>
          </ul>
        </div>

        <%!-- Sort dropdown --%>
        <div class="dropdown dropdown-end">
          <label
            tabindex="0"
            class="flex items-center gap-1.5 px-2 py-1 bg-surface-raised border border-border rounded-md text-xs text-fg-secondary hover:text-fg transition-colors cursor-pointer"
          >
            <.icon name="hero-arrows-up-down" class="size-3" /> Sort
          </label>
          <ul
            tabindex="0"
            class="dropdown-content menu bg-surface-raised border border-border rounded-lg z-10 w-44 p-1 shadow-lg mt-1"
          >
            <li>
              <button
                phx-click="sort"
                phx-value-sort_by="priority"
                class={["text-xs rounded", @sort_by == :priority && "text-fg bg-accent-indigo/10"]}
              >
                Priority
              </button>
            </li>
            <li>
              <button
                phx-click="sort"
                phx-value-sort_by="inserted_at"
                class={[
                  "text-xs rounded",
                  @sort_by == :inserted_at && "text-fg bg-accent-indigo/10"
                ]}
              >
                Date created
              </button>
            </li>
            <li>
              <button
                phx-click="sort"
                phx-value-sort_by="title"
                class={["text-xs rounded", @sort_by == :title && "text-fg bg-accent-indigo/10"]}
              >
                Title
              </button>
            </li>
          </ul>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <.presence_indicator presences={@presences} current_user={@display_name} />

        <%!-- View toggle --%>
        <div class="flex bg-surface-raised border border-border rounded-md overflow-hidden">
          <button
            phx-click="toggle_view"
            phx-value-view="board"
            class={[
              "px-2 py-1 transition-colors",
              @view_mode == :board && "bg-accent-indigo/20 text-fg",
              @view_mode != :board && "text-fg-muted hover:text-fg"
            ]}
          >
            <.icon name="hero-view-columns" class="size-3.5" />
          </button>
          <button
            phx-click="toggle_view"
            phx-value-view="list"
            class={[
              "px-2 py-1 transition-colors",
              @view_mode == :list && "bg-accent-indigo/20 text-fg",
              @view_mode != :list && "text-fg-muted hover:text-fg"
            ]}
          >
            <.icon name="hero-bars-3" class="size-3.5" />
          </button>
        </div>

        <%!-- New ticket button --%>
        <.link
          id="new-issue-button"
          patch={~p"/w/#{@workspace_slug}/tickets/new"}
          class="flex items-center gap-1.5 bg-accent-indigo hover:bg-accent-indigo-hover text-white rounded-md overflow-hidden cursor-pointer"
        >
          <span class="px-3 py-1 text-sm font-medium">+ Issue</span>
        </.link>
      </div>
    </header>

    <%!-- Board view --%>
    <div
      :if={@live_action != :show && @view_mode == :board}
      id="ticket-board"
      phx-hook="KanbanBoard"
      class="flex gap-4 overflow-x-auto p-4 flex-1"
    >
      <.status_column
        :for={status <- @statuses}
        status={status}
        last={status == List.last(@statuses)}
        count={length(Map.get(@tickets_by_status, status, []))}
        stream={stream_for(@streams, status)}
        prefix={@workspace_prefix}
        workspace_slug={@workspace_slug}
        loop_info={@loop_info}
      />
    </div>

    <%!-- List view --%>
    <div :if={@live_action != :show && @view_mode == :list} class="flex-1 overflow-auto px-2 py-2">
      <div :for={status <- @statuses} :if={Map.get(@tickets_by_status, status, []) != []}>
        <div class="flex items-center gap-2 px-3 py-1.5">
          <.status_icon status={status} />
          <span class="text-xs font-medium text-fg-secondary">{status_label(status)}</span>
          <span class="text-[10px] text-fg-muted">
            {length(Map.get(@tickets_by_status, status, []))}
          </span>
        </div>
        <div
          id={"list-#{status}"}
          phx-update="stream"
        >
          <.ticket_row
            :for={{dom_id, ticket} <- stream_for(@streams, status)}
            ticket={ticket}
            id={dom_id}
            prefix={@workspace_prefix}
            workspace_slug={@workspace_slug}
            loop_info={@loop_info}
          />
        </div>
      </div>
      <div
        :if={@ticket_count == 0}
        class="flex flex-col items-center justify-center py-16 space-y-3"
      >
        <.icon name="hero-ticket" class="size-10 text-fg-muted" />
        <h3 class="text-sm font-semibold text-fg">No issues yet</h3>
        <p class="text-xs text-fg-muted">Create your first issue to get started.</p>
        <.link
          patch={~p"/w/#{@workspace_slug}/tickets/new"}
          class="mt-2 inline-flex items-center gap-1.5 px-4 py-2 bg-accent-indigo hover:bg-accent-indigo-hover text-white text-sm font-medium rounded-lg transition-colors"
        >
          + New issue
        </.link>
      </div>
    </div>

    <%!-- Detail view --%>
    <.live_component
      :if={@live_action == :show && @ticket}
      module={AlgedoniaWeb.TicketLive.TicketDetailComponent}
      id="ticket-detail"
      ticket={@ticket}
      ticket_form={@ticket_form}
      workspace_slug={@workspace_slug}
      workspace_prefix={@workspace_prefix}
      save_state={@save_state}
      blocker_tickets={@blocker_tickets}
      blocked_by_options={@blocked_by_options}
      blocked_by_search={@blocked_by_search}
      loop_id={@loop_id}
      review_loop_id={@review_loop_id}
      hook_loops={@hook_loops}
      transition_hooks={@transition_hooks}
      comments={@comments}
      comment_form={@comment_form}
      comment_form_id={@comment_form_id}
      reply_to={@reply_to}
      reply_form={@reply_form}
      editing_comment_id={@editing_comment_id}
      edit_form={@edit_form}
    />
  </div>

  <.shortcut_help show={@show_shortcut_help} page="tickets" />

  <%!-- Create/Edit modal --%>
  <.modal
    :if={@live_action in [:new, :edit]}
    id="ticket-modal"
    show
    on_cancel={JS.patch(~p"/w/#{@workspace_slug}/tickets")}
  >
    <.live_component
      module={AlgedoniaWeb.TicketLive.TicketFormComponent}
      id={(@ticket && @ticket.id) || :new}
      ticket={@ticket}
      action={@live_action}
      patch={~p"/w/#{@workspace_slug}/tickets"}
      return_to={~p"/w/#{@workspace_slug}/tickets"}
      workspace={@current_workspace}
      workspace_slug={@workspace_slug}
    />
  </.modal>

  <.modal
    :if={@confirm_delete}
    id="ticket-delete-modal"
    show
    on_cancel={JS.push("cancel_delete")}
  >
    <div class="space-y-4">
      <div>
        <h3 class="text-sm font-semibold text-fg">Delete issue?</h3>
        <p class="text-xs text-fg-muted mt-1">
          This cannot be undone.
        </p>
      </div>
      <div class="flex items-center justify-end gap-2">
        <button
          phx-click="cancel_delete"
          class="px-3 py-1.5 text-xs text-fg-muted hover:text-fg rounded-md hover:bg-surface-raised"
        >
          Cancel
        </button>
        <button
          phx-click="confirm_delete_now"
          phx-value-id={@delete_ticket_id}
          class="px-3 py-1.5 text-xs text-white bg-status-red hover:bg-status-red/80 rounded-md"
          phx-disable-with="Deleting..."
        >
          Delete
        </button>
      </div>
    </div>
  </.modal>

  <.modal
    :if={@confirm_reset}
    id="ticket-reset-modal"
    show
    on_cancel={JS.push("cancel_reset")}
  >
    <div class="space-y-4">
      <div>
        <h3 class="text-sm font-semibold text-fg">Start over?</h3>
        <p class="text-xs text-fg-muted mt-1">
          This will delete all loops and steps for this issue and reset it to backlog. This cannot be undone.
        </p>
      </div>
      <div class="flex items-center justify-end gap-2">
        <button
          phx-click="cancel_reset"
          class="px-3 py-1.5 text-xs text-fg-muted hover:text-fg rounded-md hover:bg-surface-raised"
        >
          Cancel
        </button>
        <button
          phx-click="confirm_reset_now"
          class="px-3 py-1.5 text-xs text-white bg-status-orange hover:bg-status-orange/80 rounded-md"
          phx-disable-with="Resetting..."
        >
          Start Over
        </button>
      </div>
    </div>
  </.modal>

  <.modal
    :if={@show_new_workspace_modal}
    id="new-workspace-modal"
    show
    on_cancel={JS.push("close_new_workspace_modal")}
  >
    <h2 class="text-lg font-semibold text-fg mb-4">New workspace</h2>
    <.live_component
      module={AlgedoniaWeb.WorkspaceLive.NewWorkspaceFormComponent}
      id="new-workspace-form"
      form={@new_workspace_form}
      repos={@new_ws_repos}
      repo_search={@new_ws_repo_search}
      repo_dropdown_open={@new_ws_repo_dropdown_open}
      github_repo_url={@new_ws_github_repo_url}
      workspace_name={@new_ws_workspace_name}
      show_url_input={@new_ws_show_url_input}
    />
  </.modal>
</Layouts.app>
