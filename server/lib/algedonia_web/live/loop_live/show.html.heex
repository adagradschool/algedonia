<div
  id="loop-shell"
  class="h-screen grid grid-rows-[auto_1fr] overflow-hidden bg-surface"
  phx-hook="KeyboardShortcuts"
  data-page="loop"
>
  <div
    id="global-command-palette-loop"
    phx-hook="CommandPalette"
    data-tickets-path={~p"/w/#{@workspace_slug}/tickets"}
    data-monitor-path={~p"/w/#{@workspace_slug}/monitor"}
    data-new-issue-path={~p"/w/#{@workspace_slug}/tickets/new"}
    data-loop-path={loop_show_path(@workspace_slug, @ticket, @route_ticket_ref, @loop_id)}
  />
  <div
    id="loop-workspace-layout"
    phx-hook="SidebarPanel"
    data-min-width="224"
    data-max-width="448"
    data-default-width="256"
    data-collapsed-width="52"
    data-handle-width="16"
    data-storage-key="loop-left-sidebar-width"
    class="grid grid-cols-[var(--left-sidebar-width,16rem)_16px_minmax(0,1fr)] overflow-hidden"
  >
    <div
      id="loop-left-sidebar-panel"
      data-sidebar-panel
      class="min-w-0 overflow-hidden"
    >
      <Layouts.workspace_sidebar
        current_workspace={@current_workspace}
        current_user={@current_user}
        class="!w-full h-full border-r-0"
      >
        <div>
          <div
            data-sidebar-expanded-only
            class="text-[11px] uppercase tracking-wide text-fg-muted"
          >
            Loop Tree
          </div>
          <div data-sidebar-expanded-only class="mt-2 text-[11px] text-fg-subtle">
            Single-loop mode (maker/checker)
          </div>
          <div class="loop-sidebar-loop-card mt-3 rounded-md border border-border bg-surface-panel px-2.5 py-2.5">
            <div class="flex items-center gap-2">
              <span class={[
                "loop-sidebar-loop-dot size-2 rounded-full",
                cond do
                  @stage == "completed" -> "bg-status-green"
                  @stage == "failed" -> "bg-status-red"
                  @active -> "bg-status-blue animate-pulse"
                  true -> "bg-fg-muted"
                end
              ]} />
              <span
                data-sidebar-expanded-only
                class="text-sm font-medium text-fg whitespace-normal break-words leading-snug"
              >
                {@loop_title}
              </span>
            </div>
            <div data-sidebar-expanded-only class="mt-1 text-[12px] text-fg-muted">
              Attempt {@attempt} · {String.upcase(@stage)}
            </div>
          </div>
        </div>
      </Layouts.workspace_sidebar>
    </div>

    <div class="group relative bg-surface">
      <button
        type="button"
        data-sidebar-handle
        aria-label="Resize sidebar"
        aria-controls="loop-left-sidebar-panel"
        class="h-full w-full cursor-col-resize touch-none focus:outline-none border-0 bg-transparent p-0 appearance-none"
      >
        <span class="pointer-events-none mx-auto block h-full w-px bg-border transition-colors group-hover:bg-accent-indigo/70 group-focus-within:bg-accent-indigo/70" />
      </button>
      <button
        type="button"
        data-sidebar-toggle
        aria-controls="loop-left-sidebar-panel"
        aria-label="Collapse sidebar"
        title="Collapse sidebar"
        class="group absolute left-1/2 top-2 -translate-x-1/2 inline-flex h-4 w-4 items-center justify-center rounded border border-border bg-surface-panel text-fg-muted hover:text-fg hover:bg-surface-raised transition-colors"
      >
        <.icon
          name="hero-chevron-left-mini"
          class="size-3 transition-transform group-data-[state=collapsed]:rotate-180"
        />
      </button>
    </div>

    <main
      id="loop-inspector-layout"
      phx-hook="SplitPanel"
      data-min-width="320"
      data-max-width="640"
      data-default-width="384"
      data-storage-key="loop-inspector-width"
      class="grid grid-cols-[minmax(0,1fr)_10px_var(--inspector-width,24rem)] overflow-hidden"
    >
      <section
        id="loop-terminal-panel"
        data-split-left
        class="bg-[#0a0d12] flex flex-col overflow-hidden"
      >
        <div class="h-12 border-b border-border-soft px-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0">
            <h1 class="text-base font-medium text-fg whitespace-normal break-words leading-tight">
              {@loop_title}
            </h1>
            <span
              :if={!@planning_session?}
              class={[
                "px-2 py-0.5 rounded text-[11px] font-semibold uppercase tracking-wide",
                cond do
                  @stage == "completed" -> "bg-status-green/20 text-status-green"
                  @stage == "failed" -> "bg-status-red/20 text-status-red"
                  @stage == "checker" -> "bg-status-yellow/20 text-status-yellow"
                  true -> "bg-accent-indigo/20 text-accent-indigo"
                end
              ]}
            >
              {@stage}
            </span>
            <span
              :if={!@planning_session?}
              id="loop-index-badge"
              class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border"
            >
              Loop #{@attempt}
            </span>
          </div>

          <button
            :if={@active && @planning_session?}
            phx-click="finish_planning"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-status-green hover:bg-status-green/80 text-white text-sm font-medium transition-colors"
            type="button"
          >
            Done
          </button>
        </div>

        <div :if={!@planning_session?} class="border-b border-border-soft bg-[#0d1017]">
          <button
            type="button"
            phx-click="toggle_steps"
            class="w-full px-4 h-10 flex items-center justify-between text-xs uppercase tracking-wide text-fg-muted hover:text-fg transition-colors"
          >
            <span class="flex items-center gap-2">
              <span>Steps</span>
              <span class="text-[10px] text-fg-subtle">({length(@step_history)})</span>
            </span>
            <span class={[
              "transition-transform duration-200",
              if(@show_steps, do: "rotate-180", else: "")
            ]}>
              <.icon name="hero-chevron-down-mini" class="size-4" />
            </span>
          </button>

          <div class={[
            "overflow-hidden transition-all duration-200",
            if(@show_steps, do: "max-h-44 opacity-100", else: "max-h-0 opacity-0")
          ]}>
            <div class="px-3 pb-3">
              <div :if={Enum.empty?(@step_history)} class="px-2 py-2 text-xs text-fg-muted">
                No maker/checker runs yet.
              </div>
              <div
                :if={!Enum.empty?(@step_history)}
                class="flex items-center gap-2 overflow-x-auto pb-1"
              >
                <button
                  :for={entry <- @step_history}
                  type="button"
                  phx-click="select_step"
                  phx-value-step_id={entry.id}
                  class={[
                    "step-chip-enter shrink-0 px-3 py-1.5 rounded-md border text-[11px] font-medium transition-colors flex items-center gap-2",
                    if(@selected_step_id == entry.id,
                      do: "bg-accent-indigo/20 text-fg border-accent-indigo/60",
                      else: "bg-surface-panel text-fg-muted border-border hover:text-fg-secondary"
                    )
                  ]}
                >
                  <span class={[
                    "inline-flex items-center px-1.5 py-0.5 rounded text-[10px] uppercase",
                    if(entry.role == "maker",
                      do: "bg-accent-indigo/20 text-accent-indigo",
                      else: "bg-status-yellow/20 text-status-yellow"
                    )
                  ]}>
                    {entry.role}
                  </span>
                  <span>{String.capitalize(entry.role)} #{entry.attempt}</span>
                  <span
                    :if={@current_step_id == entry.id}
                    class="animate-spin inline-block size-3 border border-status-blue border-t-transparent rounded-full"
                  />
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="relative flex-1 min-h-0 p-2">
          <div
            id={@terminal_run_key}
            class="run-panel-enter absolute inset-2 border border-border-soft bg-[#13172a] overflow-hidden"
          >
            <.claude_terminal_panel
              terminal_run_key={@terminal_run_key}
              loop_id={@terminal_stream_loop_id || ""}
              terminal_ws_url={@terminal_ws_url}
              terminal_ws_token={@terminal_ws_token}
            />
          </div>
        </div>
      </section>

      <div class="group bg-surface">
        <button
          id="loop-inspector-resize-handle"
          type="button"
          data-split-handle
          aria-controls="loop-inspector-panel"
          aria-label="Resize inspector panel"
          aria-orientation="vertical"
          class="h-full w-full cursor-col-resize touch-none focus:outline-none border-0 bg-transparent p-0 appearance-none"
        >
          <span class="pointer-events-none mx-auto block h-full w-px bg-border transition-colors group-hover:bg-accent-indigo/70 group-focus-within:bg-accent-indigo/70" />
        </button>
      </div>

      <section
        id="loop-inspector-panel"
        data-split-right
        class="bg-surface-panel flex flex-col overflow-hidden"
      >
        <div
          :if={!@planning_session?}
          class="h-12 border-b border-border-soft bg-surface px-2 flex items-center gap-1"
        >
          <button
            phx-click="switch_tab"
            phx-value-tab="overview"
            class={[
              "h-full px-3 text-[12px] border-b-2 transition-colors flex items-center gap-1",
              if(@active_tab == "overview",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
          >
            Overview
            <.kbd>1</.kbd>
          </button>
          <button
            phx-click="switch_tab"
            phx-value-tab="rubric"
            class={[
              "h-full px-3 text-[12px] border-b-2 transition-colors flex items-center gap-1",
              if(@active_tab == "rubric",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
          >
            Rubric
            <.kbd>2</.kbd>
          </button>
          <button
            phx-click="switch_tab"
            phx-value-tab="diff"
            class={[
              "h-full px-3 text-[12px] border-b-2 transition-colors flex items-center gap-1",
              if(@active_tab == "diff",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
          >
            Diff
            <.kbd>3</.kbd>
          </button>
        </div>

        <div
          :if={!@planning_session? and @active_tab == "overview"}
          class="p-3 overflow-y-auto space-y-4"
        >
          <div
            :if={@final_verdict}
            class={[
              "rounded-md border px-3 py-3",
              if(@final_verdict.verdict == "pass",
                do: "border-status-green/40 bg-status-green/5",
                else: "border-status-red/40 bg-status-red/5"
              )
            ]}
          >
            <div class="flex items-center gap-2 mb-2">
              <span class={[
                "px-2 py-0.5 rounded text-[11px] font-semibold uppercase",
                if(@final_verdict.verdict == "pass",
                  do: "bg-status-green/20 text-status-green",
                  else: "bg-status-red/20 text-status-red"
                )
              ]}>
                {if @final_verdict.verdict == "pass", do: "Passed", else: "Failed"}
              </span>
              <span class="text-[11px] uppercase tracking-wide text-fg-muted">
                {verdict_heading(@final_verdict, @loop_record)}
              </span>
            </div>
            <div
              :if={Map.get(@final_verdict, :feedback, "") != ""}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@final_verdict.feedback)}
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted">Ticket</div>
            <div class="mt-1 text-sm font-semibold text-fg break-words">
              {if @ticket, do: @ticket.title, else: "No ticket loaded"}
            </div>
            <div :if={@ticket} class="mt-2 flex flex-wrap gap-1.5">
              <span class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border">
                Status: {@ticket.status}
              </span>
              <span class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border">
                Priority: {@ticket.priority}
              </span>
              <span class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border">
                Type: {@ticket.type}
              </span>
              <span
                :if={@ticket.coding_agent}
                class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border"
              >
                Agent: {@ticket.coding_agent}
              </span>
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Description</div>
            <div
              :if={@ticket && @ticket.description && String.trim(@ticket.description) != ""}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@ticket.description)}
            </div>
            <div
              :if={!@ticket || !@ticket.description || String.trim(@ticket.description) == ""}
              class="text-xs text-fg-muted"
            >
              No description yet.
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">
              Acceptance Criteria
            </div>
            <div
              :if={
                @ticket && @ticket.acceptance_criteria &&
                  String.trim(@ticket.acceptance_criteria) != ""
              }
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@ticket.acceptance_criteria)}
            </div>
            <div
              :if={
                !@ticket || !@ticket.acceptance_criteria ||
                  String.trim(@ticket.acceptance_criteria) == ""
              }
              class="text-xs text-fg-muted"
            >
              No acceptance criteria yet.
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">
              Ticket Rubric
            </div>
            <div
              :if={@ticket && @ticket.rubric && String.trim(@ticket.rubric) != ""}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@ticket.rubric)}
            </div>
            <div
              :if={!@ticket || !@ticket.rubric || String.trim(@ticket.rubric) == ""}
              class="text-xs text-fg-muted"
            >
              No rubric yet.
            </div>
          </div>
        </div>

        <div
          :if={!@planning_session? and @active_tab == "rubric"}
          class="p-3 overflow-y-auto space-y-3"
        >
          <div class="rubric-editor-shell" data-shortcuts="off">
            <div class="rubric-editor-head">
              <h2 class="text-sm font-semibold text-fg">Rubric</h2>
            </div>
            <div
              id="rubric-editor"
              phx-hook="MarkdownEditor"
              phx-update="ignore"
              data-markdown={@rubric}
              class="rubric-editor"
            />
          </div>
        </div>

        <div
          :if={!@planning_session? and @active_tab == "diff"}
          id="diff-tab-content"
          phx-hook="DiffViewer"
          class="flex-1 overflow-y-auto"
        >
          <div class="px-3 py-2 flex items-center justify-between border-b border-border">
            <span class="text-[11px] uppercase tracking-wide text-fg-muted">Changes</span>
            <div class="flex items-center gap-1">
              <button
                type="button"
                phx-click="open_editor"
                class="inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] text-fg-muted hover:text-fg hover:bg-surface-raised transition-colors"
                title="Open worktree in editor"
              >
                <.icon name="hero-code-bracket-mini" class="size-3" /> Open in Editor
              </button>
              <button
                type="button"
                phx-click="refresh_diff"
                class="inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] text-fg-muted hover:text-fg hover:bg-surface-raised transition-colors"
              >
                <.icon name="hero-arrow-path-mini" class="size-3" /> Refresh
              </button>
            </div>
          </div>

          <.diff_viewer
            diff_content={@diff_content}
            diff_loading={@diff_loading}
            diff_error={@diff_error}
            inline_reviews={@inline_reviews}
            inline_comment_form={@inline_comment_form}
            loop_id={@loop_id}
            has_daemon={@loop_record != nil && @loop_record.assigned_daemon_id != nil}
            loop_started={@active || (@loop_record != nil && @loop_record.current_attempt > 0)}
            active={@active}
          />
        </div>

        <div :if={@planning_session?} class="p-3 overflow-y-auto space-y-3">
          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted">Ticket</div>
            <div class="mt-1 text-sm font-semibold text-fg break-words">
              {if @ticket, do: @ticket.title, else: "Planning ticket"}
            </div>
            <div :if={@ticket} class="mt-2 flex flex-wrap gap-1.5">
              <span class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border">
                Status: {@ticket.status}
              </span>
              <span class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border">
                Priority: {@ticket.priority}
              </span>
              <span class="px-2 py-0.5 rounded text-[11px] border bg-surface-panel text-fg-muted border-border">
                Type: {@ticket.type}
              </span>
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Description</div>
            <div
              :if={@ticket && @ticket.description && String.trim(@ticket.description) != ""}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@ticket.description)}
            </div>
            <div
              :if={!@ticket || !@ticket.description || String.trim(@ticket.description) == ""}
              class="text-xs text-fg-muted"
            >
              No description yet.
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">
              Acceptance Criteria
            </div>
            <div
              :if={
                @ticket && @ticket.acceptance_criteria &&
                  String.trim(@ticket.acceptance_criteria) != ""
              }
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@ticket.acceptance_criteria)}
            </div>
            <div
              :if={
                !@ticket || !@ticket.acceptance_criteria ||
                  String.trim(@ticket.acceptance_criteria) == ""
              }
              class="text-xs text-fg-muted"
            >
              No acceptance criteria yet.
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Rubric</div>
            <div
              :if={@ticket && @ticket.rubric && String.trim(@ticket.rubric) != ""}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@ticket.rubric)}
            </div>
            <div
              :if={!@ticket || !@ticket.rubric || String.trim(@ticket.rubric) == ""}
              class="text-xs text-fg-muted"
            >
              No rubric yet.
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Comments</div>
            <div :if={@comments == []} class="text-xs text-fg-muted">
              No comments yet.
            </div>
            <div :for={comment <- @comments} class="mb-3 last:mb-0">
              <div class="flex items-center gap-2 mb-1">
                <.avatar name={comment.author} />
                <span class="text-xs font-medium text-fg">{comment.author}</span>
                <span class="text-xs text-fg-muted">
                  <.relative_time datetime={comment.inserted_at} />
                </span>
              </div>
              <div class="pl-7 text-xs text-fg-secondary markdown break-words">
                {render_markdown(comment.body)}
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <footer class="h-[26px] border-t border-border bg-surface-sidebar px-2 flex items-center text-[11px] text-fg-muted">
    <span class="px-2">Loop {@loop_id}</span>
    <span class="px-2 border-l border-border">PTY connected</span>
    <span class="px-2 border-l border-border">Stage {@stage}</span>
    <span class="ml-auto px-2 flex items-center gap-1">
      <.kbd>?</.kbd>
      shortcuts
    </span>
  </footer>
</div>

<.shortcut_help show={@show_shortcut_help} page="loop" />
<Layouts.flash_group flash={@flash} />
