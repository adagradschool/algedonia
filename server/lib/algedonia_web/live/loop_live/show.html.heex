<div class="h-screen grid grid-rows-[1fr_26px] overflow-hidden bg-surface">
  <div class="grid grid-cols-[260px_1fr] overflow-hidden">
    <aside class="bg-surface-sidebar border-r border-border flex flex-col overflow-hidden">
      <div class="p-4 border-b border-border-soft">
        <div class="text-sm font-semibold text-fg">Algedonia</div>
        <div class="mt-4 space-y-1">
          <.link
            navigate={~p"/w/#{@workspace_slug}/tickets"}
            class="block rounded-md px-2.5 py-1.5 text-fg-secondary hover:text-fg hover:bg-surface-raised transition-colors"
          >
            Tickets
          </.link>
          <.link
            navigate={~p"/w/#{@workspace_slug}/monitor"}
            class="block rounded-md px-2.5 py-1.5 text-fg-secondary hover:text-fg hover:bg-surface-raised transition-colors"
          >
            Monitor
          </.link>
        </div>
      </div>

      <div class="p-3 border-b border-border-soft">
        <div class="text-[11px] uppercase tracking-wide text-fg-muted">Loop Tree</div>
        <div class="mt-2 text-[11px] text-fg-subtle">Single-loop mode (maker/checker)</div>
      </div>

      <div class="p-2 overflow-y-auto">
        <div class="rounded-md border border-border bg-surface-panel px-2 py-2">
          <div class="flex items-center gap-2">
            <span class={[
              "size-2 rounded-full",
              if(@active, do: "bg-status-blue animate-pulse", else: "bg-fg-muted")
            ]} />
            <span class="text-xs font-medium text-fg truncate">{@loop_title}</span>
          </div>
          <div class="mt-1 text-[11px] text-fg-muted">
            Attempt {@attempt} · {String.upcase(@stage)}
          </div>
        </div>
      </div>
    </aside>

    <main class="grid grid-cols-[1fr_24rem] overflow-hidden">
      <section class="bg-black flex flex-col overflow-hidden">
        <div class="h-11 border-b border-border-soft bg-black/50 px-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0">
            <h1 class="text-xs font-medium text-fg truncate">{@loop_title}</h1>
            <span class={[
              "px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wide",
              if(@stage == "checker",
                do: "bg-status-yellow/20 text-status-yellow",
                else: "bg-accent-indigo/20 text-accent-indigo"
              )
            ]}>
              {@stage}
            </span>
            <span class={[
              "px-1.5 py-0.5 rounded text-[10px] border",
              if(@active,
                do: "bg-status-green/10 text-status-green border-status-green/40",
                else: "bg-surface-panel text-fg-muted border-border"
              )
            ]}>
              {if @active, do: "Active", else: "Inactive"}
            </span>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <button
              :if={!@active}
              phx-click="start_loop"
              class="px-2.5 py-1 rounded-md bg-status-green hover:bg-status-green/80 text-white text-xs font-medium transition-colors"
              type="button"
            >
              Start Loop
            </button>
            <button
              :if={@active}
              phx-click="stop_loop"
              class="px-2.5 py-1 rounded-md bg-status-red hover:bg-status-red/80 text-white text-xs font-medium transition-colors"
              type="button"
            >
              Stop Loop
            </button>
          </div>
        </div>

        <div class="relative flex-1 min-h-0">
          <div
            id="terminal"
            phx-hook="XTerm"
            phx-update="ignore"
            style="position:absolute;inset:8px;"
          >
          </div>
        </div>
      </section>

      <section class="bg-surface-panel border-l border-border flex flex-col overflow-hidden">
        <div class="h-11 border-b border-border bg-surface px-1 flex items-center">
          <button
            phx-click="switch_tab"
            phx-value-tab="overview"
            class={[
              "px-3 py-2 text-[11px] border-b-2 transition-colors",
              if(@active_tab == "overview",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
          >
            Overview
          </button>
          <button
            phx-click="switch_tab"
            phx-value-tab="rubric"
            class={[
              "px-3 py-2 text-[11px] border-b-2 transition-colors",
              if(@active_tab == "rubric",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
          >
            Rubric
          </button>
          <button
            phx-click="switch_tab"
            phx-value-tab="history"
            class={[
              "px-3 py-2 text-[11px] border-b-2 transition-colors",
              if(@active_tab == "history",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
          >
            History
          </button>
        </div>

        <div :if={@active_tab == "overview"} class="p-3 overflow-y-auto space-y-4">
          <div class="rounded-md border border-border bg-surface p-2">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">
              Context Summary
            </div>
            <div class="text-xs text-fg-secondary whitespace-pre-wrap">
              {if @ticket,
                do: @ticket.description || "No ticket description.",
                else: "Ad hoc loop."}
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface p-2">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">
              Acceptance Criteria
            </div>
            <div class="text-xs text-fg-secondary whitespace-pre-wrap">
              {if @acceptance_criteria != "", do: @acceptance_criteria, else: "Not provided yet."}
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface p-2">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Final Result</div>
            <div :if={@overview_loading} class="text-xs text-fg-muted">
              Generating overview...
            </div>
            <div
              :if={@overview_content}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@overview_content)}
            </div>
            <div :if={!@overview_content && !@overview_loading} class="text-xs text-fg-muted">
              Overview will be generated automatically when the loop starts.
            </div>
          </div>
        </div>

        <div :if={@active_tab == "rubric"} class="p-3 overflow-y-auto space-y-3">
          <p class="text-[11px] text-fg-muted italic">
            Collaborative markdown editor. Changes apply to the next maker/checker run.
          </p>
          <div
            id="rubric-editor"
            phx-hook="MarkdownEditor"
            data-markdown={@rubric}
            class="rounded-md border border-border bg-surface"
          />
          <div class="rounded-md border border-border bg-surface p-2">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Preview</div>
            <div class="markdown text-xs text-fg-secondary">
              {render_markdown(@rubric)}
            </div>
          </div>
        </div>

        <div :if={@active_tab == "history"} class="p-3 overflow-y-auto">
          <div :if={Enum.empty?(@history)} class="text-xs text-fg-muted">
            No maker/checker runs yet.
          </div>
          <div
            :for={entry <- Enum.reverse(@history)}
            class="py-2 border-b border-border-soft last:border-b-0"
          >
            <div class="flex items-center gap-2 text-xs">
              <span class="font-semibold text-fg">#{entry.attempt}</span>
              <span class={[
                "px-1.5 py-0.5 rounded text-[10px] uppercase",
                if(entry.role == "maker",
                  do: "bg-accent-indigo/20 text-accent-indigo",
                  else: "bg-status-yellow/20 text-status-yellow"
                )
              ]}>
                {entry.role}
              </span>
              <span
                :if={Map.get(entry, :verdict)}
                class={[
                  "px-1.5 py-0.5 rounded text-[10px] uppercase",
                  if(entry.verdict == "pass",
                    do: "bg-status-green/20 text-status-green",
                    else: "bg-status-red/20 text-status-red"
                  )
                ]}
              >
                {entry.verdict}
              </span>
              <span class="ml-auto text-[10px] text-fg-muted">{entry.status}</span>
            </div>
            <div
              :if={Map.get(entry, :feedback, "") != ""}
              class="mt-1 text-[11px] text-fg-secondary"
            >
              {entry.feedback}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <footer class="h-[26px] border-t border-border bg-surface-sidebar px-2 flex items-center text-[11px] text-fg-muted">
    <span class="px-2">Loop {@loop_id}</span>
    <span class="px-2 border-l border-border">PTY connected</span>
    <span class="px-2 border-l border-border">Stage {@stage}</span>
  </footer>
</div>

<Layouts.flash_group flash={@flash} />
