<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_workspace={@current_workspace}
  current_user={@current_user}
>
  <div class="flex flex-col h-full">
    <div class="h-12 border-b border-border px-6 flex items-center justify-between bg-surface">
      <div class="flex items-center gap-3">
        <.link
          navigate={~p"/w/#{@workspace_slug}/monitor"}
          class="text-fg-muted hover:text-fg transition-colors"
        >
          <.icon name="hero-arrow-left" class="size-4" />
        </.link>
        <h1 class="text-sm font-semibold text-fg">
          Loop: <span class="text-accent-indigo">{@loop_id}</span>
        </h1>
        <span
          :if={@active}
          class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-green-500/15 text-green-300 border border-green-500/30"
        >
          Active
        </span>
        <span
          :if={!@active}
          class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-surface-raised text-fg-muted border border-border"
        >
          Inactive
        </span>
      </div>
      <div class="flex items-center gap-2">
        <button
          :if={!@active}
          phx-click="start_loop"
          class="px-3 py-1.5 bg-status-green hover:bg-status-green/80 text-white text-xs font-medium rounded-md transition-colors"
        >
          Start Loop
        </button>
        <button
          :if={@active}
          phx-click="stop_loop"
          class="px-3 py-1.5 bg-status-red hover:bg-status-red/80 text-white text-xs font-medium rounded-md transition-colors"
        >
          Stop Loop
        </button>
      </div>
    </div>
    <div class="flex-1 bg-surface-panel p-1 min-h-0 relative">
      <div
        id="terminal"
        phx-hook="XTerm"
        phx-update="ignore"
        style="position:absolute;top:8px;left:8px;right:8px;bottom:8px;"
      >
      </div>
    </div>
  </div>
</Layouts.app>
