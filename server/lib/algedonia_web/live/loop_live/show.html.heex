<div
  id="loop-shell"
  class="h-screen grid grid-rows-[1fr_26px] overflow-hidden bg-surface"
  phx-hook="KeyboardShortcuts"
  data-page="loop"
>
  <div class="grid grid-cols-[16rem_1fr] overflow-hidden">
    <Layouts.workspace_sidebar
      current_workspace={@current_workspace}
      current_user={@current_user}
    >
      <div>
        <div class="text-[11px] uppercase tracking-wide text-fg-muted">Loop Tree</div>
        <div class="mt-2 text-[11px] text-fg-subtle">Single-loop mode (maker/checker)</div>
        <div class="mt-3 rounded-md border border-border bg-surface-panel px-2.5 py-2.5">
          <div class="flex items-center gap-2">
            <span class={[
              "size-2 rounded-full",
              cond do
                @stage == "completed" -> "bg-status-green"
                @stage == "failed" -> "bg-status-red"
                @active -> "bg-status-blue animate-pulse"
                true -> "bg-fg-muted"
              end
            ]} />
            <span class="text-sm font-medium text-fg truncate">{@loop_title}</span>
          </div>
          <div class="mt-1 text-[12px] text-fg-muted">
            Attempt {@attempt} · {String.upcase(@stage)}
          </div>
        </div>
      </div>
    </Layouts.workspace_sidebar>

    <main class="grid grid-cols-[1fr_24rem] overflow-hidden">
      <section class="bg-[#0a0d12] flex flex-col overflow-hidden">
        <div class="h-12 border-b border-border-soft px-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0">
            <h1 class="text-2xl font-medium text-fg truncate">{@loop_title}</h1>
            <span class={[
              "px-2 py-0.5 rounded text-[11px] font-semibold uppercase tracking-wide",
              cond do
                @stage == "completed" -> "bg-status-green/20 text-status-green"
                @stage == "failed" -> "bg-status-red/20 text-status-red"
                @stage == "checker" -> "bg-status-yellow/20 text-status-yellow"
                true -> "bg-accent-indigo/20 text-accent-indigo"
              end
            ]}>
              {@stage}
            </span>
            <span class={[
              "px-2 py-0.5 rounded text-[11px] border",
              if(@active,
                do: "bg-status-green/10 text-status-green border-status-green/40",
                else: "bg-surface-panel text-fg-muted border-border"
              )
            ]}>
              {if @active, do: "Active", else: "Inactive"}
            </span>
          </div>

          <button
            :if={!@active}
            phx-click="start_loop"
            class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-status-green hover:bg-status-green/80 text-white text-sm font-medium transition-colors"
            type="button"
            title="Start loop (S)"
          >
            Start Loop
            <.kbd class="bg-white/15 border-white/20 text-white/70">S</.kbd>
          </button>
          <button
            :if={@active}
            phx-click="stop_loop"
            class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-status-red hover:bg-status-red/80 text-white text-sm font-medium transition-colors"
            type="button"
            title="Stop loop (S)"
          >
            Stop Loop
            <.kbd class="bg-white/15 border-white/20 text-white/70">S</.kbd>
          </button>
        </div>

        <div class="h-10 border-b border-border-soft px-4 flex items-center text-[14px] tracking-wide text-fg-muted uppercase">
          {@terminal_run_label}
        </div>

        <div class="relative flex-1 min-h-0 p-2">
          <div
            id={@terminal_run_key}
            class="run-panel-enter absolute inset-2 border border-border-soft bg-[#13172a] overflow-hidden"
          >
            <%= if @agent_type == "claude_code" do %>
              <.claude_terminal_panel terminal_run_key={@terminal_run_key} />
            <% else %>
              <.codex_chat_panel
                terminal_run_key={@terminal_run_key}
                chat_messages={@chat_messages}
              />
            <% end %>
          </div>
        </div>

        <.codex_composer
          :if={@agent_type != "claude_code"}
          terminal_run_key={@terminal_run_key}
          history={@history}
          active={@active}
          supported_models={@supported_models}
          selected_model={@selected_model}
          supported_efforts={@supported_efforts}
          selected_effort={@selected_effort}
        />
      </section>

      <section class="bg-surface-panel border-l border-border flex flex-col overflow-hidden">
        <div class="h-11 border-b border-border bg-surface px-2 flex items-center gap-1">
          <button
            phx-click="switch_tab"
            phx-value-tab="overview"
            class={[
              "px-3 py-2 text-[12px] border-b-2 transition-colors flex items-center gap-1",
              if(@active_tab == "overview",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
            title="Overview (1)"
          >
            Overview
            <.kbd>1</.kbd>
          </button>
          <button
            phx-click="switch_tab"
            phx-value-tab="rubric"
            class={[
              "px-3 py-2 text-[12px] border-b-2 transition-colors flex items-center gap-1",
              if(@active_tab == "rubric",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
            title="Rubric (2)"
          >
            Rubric
            <.kbd>2</.kbd>
          </button>
          <button
            phx-click="switch_tab"
            phx-value-tab="history"
            class={[
              "px-3 py-2 text-[12px] border-b-2 transition-colors flex items-center gap-1",
              if(@active_tab == "history",
                do: "text-fg border-accent-indigo",
                else: "text-fg-muted border-transparent hover:text-fg-secondary"
              )
            ]}
            title="History (3)"
          >
            History
            <.kbd>3</.kbd>
          </button>
        </div>

        <div :if={@active_tab == "overview"} class="p-3 overflow-y-auto space-y-4">
          <div
            :if={@final_verdict}
            class={[
              "rounded-md border px-3 py-3",
              if(@final_verdict.verdict == "pass",
                do: "border-status-green/40 bg-status-green/5",
                else: "border-status-red/40 bg-status-red/5"
              )
            ]}
          >
            <div class="flex items-center gap-2 mb-2">
              <span class={[
                "px-2 py-0.5 rounded text-[11px] font-semibold uppercase",
                if(@final_verdict.verdict == "pass",
                  do: "bg-status-green/20 text-status-green",
                  else: "bg-status-red/20 text-status-red"
                )
              ]}>
                {if @final_verdict.verdict == "pass", do: "Passed", else: "Failed"}
              </span>
              <span class="text-[11px] uppercase tracking-wide text-fg-muted">
                Final Verdict
              </span>
            </div>
            <div
              :if={Map.get(@final_verdict, :feedback, "") != ""}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@final_verdict.feedback)}
            </div>
          </div>

          <div class="rounded-md border border-border bg-surface px-3 py-3">
            <div :if={@overview_loading} class="flex items-center gap-2 text-xs text-fg-muted">
              <span class="animate-spin inline-block w-3 h-3 border border-fg-muted border-t-transparent rounded-full">
              </span>
              Generating overview...
            </div>
            <div
              :if={@overview_content}
              class="markdown text-xs text-fg-secondary"
            >
              {render_markdown(@overview_content)}
            </div>
            <div :if={!@overview_content && !@overview_loading} class="text-xs text-fg-muted">
              Overview will be generated automatically when the loop starts.
            </div>
          </div>
        </div>

        <div :if={@active_tab == "rubric"} class="p-3 overflow-y-auto space-y-3">
          <p class="text-[11px] text-fg-muted italic">
            Collaborative markdown editor. Changes apply to the next maker/checker run.
          </p>
          <div
            id="rubric-editor"
            phx-hook="MarkdownEditor"
            data-markdown={@rubric}
            class="rounded-md border border-border bg-surface"
          />
          <div class="rounded-md border border-border bg-surface p-2">
            <div class="text-[11px] uppercase tracking-wide text-fg-muted mb-2">Preview</div>
            <div class="markdown text-xs text-fg-secondary">
              {render_markdown(@rubric)}
            </div>
          </div>
        </div>

        <div :if={@active_tab == "history"} class="p-3 overflow-y-auto">
          <div :if={Enum.empty?(@visible_history)} class="text-xs text-fg-muted">
            No maker/checker runs yet.
          </div>
          <div
            :for={entry <- Enum.reverse(@visible_history)}
            class="py-2 border-b border-border-soft last:border-b-0"
          >
            <div class="flex items-center gap-2 text-xs">
              <span class="font-semibold text-fg">#{entry.attempt}</span>
              <span class={[
                "px-1.5 py-0.5 rounded text-[10px] uppercase",
                if(entry.role == "maker",
                  do: "bg-accent-indigo/20 text-accent-indigo",
                  else: "bg-status-yellow/20 text-status-yellow"
                )
              ]}>
                {entry.role}
              </span>
              <span
                :if={Map.get(entry, :verdict)}
                class={[
                  "px-1.5 py-0.5 rounded text-[10px] uppercase",
                  if(entry.verdict == "pass",
                    do: "bg-status-green/20 text-status-green",
                    else: "bg-status-red/20 text-status-red"
                  )
                ]}
              >
                {entry.verdict}
              </span>
              <span class="ml-auto text-[10px] text-fg-muted">{entry.status}</span>
            </div>
            <div
              :if={Map.get(entry, :feedback, "") != ""}
              class="mt-1 markdown text-[11px] text-fg-secondary"
            >
              {render_markdown(entry.feedback)}
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <footer class="h-[26px] border-t border-border bg-surface-sidebar px-2 flex items-center text-[11px] text-fg-muted">
    <span class="px-2">Loop {@loop_id}</span>
    <span class="px-2 border-l border-border">PTY connected</span>
    <span class="px-2 border-l border-border">Stage {@stage}</span>
    <span class="ml-auto px-2 flex items-center gap-1">
      <.kbd>?</.kbd>
      shortcuts
    </span>
  </footer>
</div>

<.shortcut_help show={@show_shortcut_help} page="loop" />
<Layouts.flash_group flash={@flash} />
